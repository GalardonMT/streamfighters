---
// src/pages/index.astro
import Navbar from "../components/Navbar.astro";
import TransmisionKick from "../components/TransmisionKick.astro";
import Patrocinios from "../components/Patrocinios.astro";
import InformacionEvento from "../components/InformacionEvento.astro";
import DotGridBackground from "../components/DotGridBackground.astro";
import HudOverlay from "../components/HudOverlay.astro";
import FightCard from "../components/FightCard.astro";
import Ubicacion from "../components/Ubicacion.astro";
import Footer from "../components/Footer.astro";
import { fights, fighters, artists } from "../data/eventData";
import "../styles/global.css";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Stream Fighters V | Sitio Oficial - WestCol en Kick</title>
		<meta
			name="description"
			content="Sitio oficial de Stream Fighters V. Información del evento, transmisión en vivo de WestCol por Kick, patrocinadores oficiales y cartelera de combates de boxeo en Bogotá."
		/>
	</head>

	<body
		class="bg-[#060A1A] text-[#EBEBF4] min-h-screen flex flex-col selection:bg-[#4236F5] selection:text-[#EBEBF4]"
	>
		<!-- Background Animated Dots Grid -->
		<DotGridBackground />

		<!-- Futuristic HUD Tech Overlay -->
		<HudOverlay />

		<!-- Navigation Bar (Logo y nombre arriba a la izquierda llevan a esta página "/") -->
		<Navbar currentPage="inicio" />

		<main class="flex-grow">
			<!-- HERO PRINCIPAL DE INICIO -->
			<section
				class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 border-b border-[#B58E7D]/20 bg-cover bg-center bg-no-repeat bg-fixed"
				style="background-image: linear-gradient(180deg, rgba(6, 10, 26, 0.75) 0%, rgba(6, 10, 26, 0.90) 70%, #060A1A 100%), url('/images/background.png');"
			>
				<!-- Glow effects -->
				<div
					class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[#4236F5]/15 rounded-full blur-[160px] pointer-events-none"
				>
				</div>

				<div
					class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center"
				>
					<!-- Hero Event Logo Principal (Tocarlo también recarga / va a inicio) -->
					<div class="flex justify-center mb-6">
						<a
							href="/"
							title="Stream Fighters V"
							class="group block"
						>
							<img
								src="/images/logo.png"
								alt="Stream Fighters V"
								class="w-72 sm:w-96 md:w-[480px] lg:w-[560px] h-auto object-contain drop-shadow-[0_15px_35px_rgba(66,54,245,0.45)] group-hover:scale-105 transition-transform duration-300"
								loading="eager"
							/>
						</a>
					</div>

					<!-- Headline -->
					<h1 class="sr-only">Stream Fighters V - Sitio Oficial</h1>
					<p
						class="mt-2 text-base sm:text-xl lg:text-2xl text-[#EBEBF4] max-w-4xl mx-auto font-bold uppercase tracking-wide leading-snug"
					>
						LA VELADA DE BOXEO Y ENTRETENIMIENTO MÁS GRANDE DE
						LATINOAMÉRICA
					</p>

					<p
						class="mt-3 text-xs sm:text-base text-[#B58E7D] max-w-2xl mx-auto font-normal"
					>
						Creado y presentado por WestCol. 9 combates de boxeo, 4
						conciertos en directo y transmisión mundial gratuita en
						exclusiva por Kick.
					</p>

					<!-- LIVE COUNTDOWN TIMER TO NOVEMBER 14, 2026 -->
					<div class="mt-10 max-w-xl mx-auto">
						<div
							class="text-[11px] font-mono uppercase tracking-widest text-[#53FC18] font-bold mb-3 flex items-center justify-center gap-2"
						>
							<span
								>CUENTA REGRESIVA PARA LA NOCHE DE CAMPEONATO</span
							>
						</div>

						<div
							id="countdown-container"
							class="flex items-center justify-center gap-2 sm:gap-6 py-4 select-none"
						>
							<div
								class="text-center min-w-[60px] sm:min-w-[80px]"
							>
								<span
									id="timer-days"
									data-text="00"
									class="timer-glitch font-display text-4xl sm:text-6xl md:text-7xl font-black text-[#EBEBF4] block leading-none tracking-wider"
									>00</span
								>
								<span
									class="text-[10px] sm:text-xs text-[#B58E7D] uppercase font-bold tracking-widest block mt-1"
									>Días</span
								>
							</div>

							<span
								class="font-display text-3xl sm:text-5xl font-black text-[#4236F5] -mt-4 opacity-75 animate-pulse select-none"
								>:</span
							>

							<div
								class="text-center min-w-[60px] sm:min-w-[80px]"
							>
								<span
									id="timer-hours"
									data-text="00"
									class="timer-glitch font-display text-4xl sm:text-6xl md:text-7xl font-black text-[#EBEBF4] block leading-none tracking-wider"
									>00</span
								>
								<span
									class="text-[10px] sm:text-xs text-[#B58E7D] uppercase font-bold tracking-widest block mt-1"
									>Horas</span
								>
							</div>

							<span
								class="font-display text-3xl sm:text-5xl font-black text-[#4236F5] -mt-4 opacity-75 animate-pulse select-none"
								>:</span
							>

							<div
								class="text-center min-w-[60px] sm:min-w-[80px]"
							>
								<span
									id="timer-minutes"
									data-text="00"
									class="timer-glitch font-display text-4xl sm:text-6xl md:text-7xl font-black text-[#EBEBF4] block leading-none tracking-wider"
									>00</span
								>
								<span
									class="text-[10px] sm:text-xs text-[#B58E7D] uppercase font-bold tracking-widest block mt-1"
									>Minutos</span
								>
							</div>

							<span
								class="font-display text-3xl sm:text-5xl font-black text-[#53FC18] -mt-4 opacity-75 animate-pulse select-none"
								>:</span
							>

							<div
								class="text-center min-w-[60px] sm:min-w-[80px]"
							>
								<span
									id="timer-seconds"
									data-text="00"
									class="timer-glitch font-display text-4xl sm:text-6xl md:text-7xl font-black text-[#53FC18] block leading-none tracking-wider"
									>00</span
								>
								<span
									class="text-[10px] sm:text-xs text-[#53FC18] uppercase font-bold tracking-widest block mt-1"
									>Segundos</span
								>
							</div>
						</div>
					</div>

					<!-- Hero Action Buttons -->
					<div
						class="mt-10 flex flex-wrap items-center justify-center gap-4"
					>
						<!-- Combates Button (Lleva a la ventana de los combates) -->
						<a
							href="/combates"
							class="bg-[#4236F5] hover:bg-[#3428df] text-[#EBEBF4] text-xs sm:text-sm font-extrabold uppercase tracking-wider py-4 px-8 rounded-xl shadow-lg shadow-black/50 hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer flex items-center gap-2.5 border border-[#5546FF]/50"
						>
							<span>🥊 Ver Cartelera de Combates</span>
							<svg
								class="w-4 h-4"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
							</svg>
						</a>

						<!-- Kick Stream Button (Desplaza a la sección de Kick o abre el canal) -->
						<a
							href="#transmision"
							class="bg-[#53FC18] hover:bg-[#43e40a] text-[#060A1A] font-black text-xs sm:text-sm uppercase tracking-wider py-4 px-7 rounded-xl shadow-lg shadow-[rgba(83,252,24,0.3)] hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer flex items-center gap-2"
						>
							<svg
								class="w-4 h-4 fill-current"
								viewBox="0 0 24 24"
							>
								<path
									d="M3 3h5v6h3V6h3V3h7v6h-3v3h-3v3h3v3h3v6h-7v-3h-3v-3H8v6H3V3z"
								></path>
							</svg>
							<span>Canal de WestCol en Kick</span>
						</a>

						<!-- Boletos TaquillaLive -->
						<a
							href="https://www.taquillalive.com/performance-details/?artist=westcol&event=TCL.EVN1440.PRF1"
							target="_blank"
							rel="noopener noreferrer"
							class="bg-[#1C1132] hover:bg-[#251744] text-[#EBEBF4] border border-[#B58E7D]/40 text-xs sm:text-sm font-bold uppercase tracking-wider py-4 px-7 rounded-xl hover:border-[#4236F5] transition-all duration-200 cursor-pointer flex items-center gap-2"
						>
							<span>🎟️ Entradas Oficiales</span>
						</a>
					</div>

					<!-- Event Fast Stats Strip -->
					<div
						class="mt-14 pt-8 border-t border-[#B58E7D]/15 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-4xl mx-auto"
					>
						<div class="text-center">
							<span
								class="font-display text-3xl sm:text-4xl font-extrabold text-[#EBEBF4] block"
								>9</span
							>
							<span
								class="text-[11px] text-[#B58E7D] uppercase font-bold tracking-wider"
								>Combates Oficiales</span
							>
						</div>
						<div class="text-center">
							<span
								class="font-display text-3xl sm:text-4xl font-extrabold text-[#53FC18] block"
								>KICK</span
							>
							<span
								class="text-[11px] text-[#53FC18] uppercase font-bold tracking-wider"
								>Transmisión WestCol</span
							>
						</div>
						<div class="text-center">
							<span
								class="font-display text-3xl sm:text-4xl font-extrabold text-[#EBEBF4] block"
								>+15.000</span
							>
							<span
								class="text-[11px] text-[#B58E7D] uppercase font-bold tracking-wider"
								>Coliseo MedPlus</span
							>
						</div>
						<div class="text-center">
							<span
								class="font-display text-3xl sm:text-4xl font-extrabold text-[#4236F5] block"
								>4</span
							>
							<span
								class="text-[11px] text-[#4236F5] uppercase font-bold tracking-wider"
								>Conciertos en Vivo</span
							>
						</div>
					</div>
				</div>
			</section>

			<!-- 1. CARTELERA: DESCUBRE LA CARTELERA COMPLETA -->
			<section
				class="relative z-10 py-16 lg:py-24 border-t border-[#B58E7D]/20 overflow-hidden"
			>
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="text-center max-w-3xl mx-auto mb-12">
						<h2
							class="font-display text-4xl sm:text-5xl font-extrabold text-[#EBEBF4] tracking-tight leading-none uppercase"
						>
							DESCUBRE LA <span class="text-[#4236F5]"
								>CARTELERA COMPLETA</span
							>
						</h2>

						<p class="mt-3 text-xs sm:text-base text-[#B58E7D]">
							Explora los 9 combates oficiales y conoce las fichas
							técnicas de los 22 boxeadores y 4 artistas de la
							velada.
						</p>
					</div>

					<!-- Highlight Preview Cards (Top 2 Matchups in minimalist style) -->
					<div
						class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6 mb-12"
					>
						{
							fights
								.slice(0, 2)
								.map((fight, index) => (
									<FightCard
										fight={fight}
										variant="wide"
									/>
								))
						}
					</div>

					<!-- Big Banner to Combates -->
					<div class="text-center">
						<a
							href="/combates"
							class="inline-flex items-center gap-3 bg-[#4236F5] hover:bg-[#3428df] text-[#EBEBF4] text-sm sm:text-base font-extrabold uppercase tracking-wider py-4 px-10 rounded-2xl shadow-xl shadow-black/50 hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer border border-[#5546FF]"
						>
							<span>Ir a la Pestaña de Combates y Boxeadores</span
							>
							<svg
								class="w-5 h-5"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
							</svg>
						</a>
					</div>
				</div>
			</section>

			<!-- 2. INFORMACIÓN OFICIAL DEL EVENTO -->
			<InformacionEvento />

			<!-- 3. DÓNDE SE TRANSMITIRÁ: CANALES DE WESTCOL EN KICK -->
			<TransmisionKick />

			<!-- 4. UBICACIÓN DEL EVENTO: COLISEO MEDPLUS Y MAPA -->
			<Ubicacion />

			<!-- 5. PATROCINIOS Y MARCAS OFICIALES (AL FINAL DE TODO) -->
			<Patrocinios />
		</main>

		<!-- FOOTER GENERAL -->
		<Footer currentPage="home" />

		<!-- CLIENT SCRIPT: LIVE COUNTDOWN TO NOV 14, 2026 -->
		<script is:inline>
			document.addEventListener("DOMContentLoaded", () => {
				const targetDate = new Date(
					"2026-11-14T17:30:00-05:00",
				).getTime();
				const daysEl = document.getElementById("timer-days");
				const hoursEl = document.getElementById("timer-hours");
				const minutesEl = document.getElementById("timer-minutes");
				const secondsEl = document.getElementById("timer-seconds");

				function updateCountdown() {
					const now = new Date().getTime();
					const distance = targetDate - now;

					if (distance <= 0) {
						if (daysEl) daysEl.textContent = "00";
						if (hoursEl) hoursEl.textContent = "00";
						if (minutesEl) minutesEl.textContent = "00";
						if (secondsEl) secondsEl.textContent = "00";
						return;
					}

					const days = Math.floor(distance / (1000 * 60 * 60 * 24));
					const hours = Math.floor(
						(distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
					);
					const minutes = Math.floor(
						(distance % (1000 * 60 * 60)) / (1000 * 60),
					);
					const seconds = Math.floor((distance % (1000 * 60)) / 1000);

					if (daysEl) {
						const val = String(days).padStart(2, "0");
						daysEl.textContent = val;
						daysEl.setAttribute("data-text", val);
					}
					if (hoursEl) {
						const val = String(hours).padStart(2, "0");
						hoursEl.textContent = val;
						hoursEl.setAttribute("data-text", val);
					}
					if (minutesEl) {
						const val = String(minutes).padStart(2, "0");
						minutesEl.textContent = val;
						minutesEl.setAttribute("data-text", val);
					}
					if (secondsEl) {
						const val = String(seconds).padStart(2, "0");
						secondsEl.textContent = val;
						secondsEl.setAttribute("data-text", val);
					}
				}

				updateCountdown();
				setInterval(updateCountdown, 1000);
			});
		</script>

		<style>
			/* Cyberpunk Glitch Effect for Countdown Timer */
			.timer-glitch {
				position: relative;
				display: inline-block;
				text-shadow:
					0 0 15px rgba(66, 54, 245, 0.45),
					1.5px 0 1px rgba(83, 252, 24, 0.6),
					-1.5px 0 1px rgba(66, 54, 245, 0.7);
				animation: timer-jitter 3.8s infinite;
			}

			.timer-glitch::before,
			.timer-glitch::after {
				content: attr(data-text);
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				pointer-events: none;
			}

			.timer-glitch::before {
				left: 2px;
				text-shadow: -2px 0 #53fc18;
				clip-path: inset(20% 0 50% 0);
				animation: timer-glitch-1 3.2s infinite linear alternate-reverse;
				opacity: 0.85;
			}

			.timer-glitch::after {
				left: -2px;
				text-shadow: 2px 0 #4236f5;
				clip-path: inset(50% 0 20% 0);
				animation: timer-glitch-2 2.6s infinite linear alternate-reverse;
				opacity: 0.85;
			}

			@keyframes timer-glitch-1 {
				0%,
				84% {
					clip-path: inset(0 0 0 0);
					transform: translate(0, 0);
					opacity: 0;
				}
				85% {
					clip-path: inset(30% 0 45% 0);
					transform: translate(-3px, 1px);
					opacity: 0.95;
				}
				88% {
					clip-path: inset(10% 0 80% 0);
					transform: translate(3px, -1px);
					opacity: 1;
				}
				91% {
					clip-path: inset(65% 0 15% 0);
					transform: translate(-2px, 2px);
					opacity: 0.85;
				}
				94% {
					clip-path: inset(45% 0 35% 0);
					transform: translate(2px, -1px);
					opacity: 0.95;
				}
				97%,
				100% {
					clip-path: inset(0 0 0 0);
					transform: translate(0, 0);
					opacity: 0;
				}
			}

			@keyframes timer-glitch-2 {
				0%,
				80% {
					clip-path: inset(0 0 0 0);
					transform: translate(0, 0);
					opacity: 0;
				}
				81% {
					clip-path: inset(65% 0 15% 0);
					transform: translate(3px, -1px);
					opacity: 0.9;
				}
				84% {
					clip-path: inset(20% 0 60% 0);
					transform: translate(-3px, 1px);
					opacity: 1;
				}
				87% {
					clip-path: inset(75% 0 5% 0);
					transform: translate(2px, -2px);
					opacity: 0.85;
				}
				90% {
					clip-path: inset(30% 0 50% 0);
					transform: translate(-2px, 1px);
					opacity: 0.9;
				}
				94%,
				100% {
					clip-path: inset(0 0 0 0);
					transform: translate(0, 0);
					opacity: 0;
				}
			}

			@keyframes timer-jitter {
				0%,
				87%,
				100% {
					transform: translate(0, 0) skew(0deg);
				}
				88% {
					transform: translate(-1.5px, 0.5px) skew(-0.5deg);
				}
				90% {
					transform: translate(1.5px, -0.5px) skew(0.5deg);
				}
				92% {
					transform: translate(-1px, -0.5px) skew(0deg);
				}
				94% {
					transform: translate(0.5px, 0.5px) skew(0deg);
				}
			}
		</style>
	</body>
</html>
