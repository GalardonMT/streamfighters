---
// DotGridBackground.astro
// Animated dot grid background with sequential row/column illumination
// Uses an offscreen canvas for base dots to avoid redrawing ~25k dots per frame
---

<canvas id="dot-grid-canvas"></canvas>

<style>
  #dot-grid-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script is:inline>
(function () {
  const canvas = document.getElementById('dot-grid-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  // ─── Config ────────────────────────────────────────
  const GAP = 8;
  const BASE_RADIUS = 1.2;
  const BASE_R = 25, BASE_G = 40, BASE_B = 90;    // Deep navy blue dots
  const BASE_ALPHA = 0.7;

  const GLOW_R = 60, GLOW_G = 100, GLOW_B = 245;   // Electric blue glow
  const GLOW_MAX_ALPHA = 0.92;
  const GLOW_RADIUS = 2.0;

  const TRAIL_LENGTH = 22;
  const DOT_DELAY = 40;          // ms between each dot activation
  const DOT_FADE_DURATION = 800; // ms for glow to fade out
  const SPAWN_MIN = 600;
  const SPAWN_MAX = 2000;
  const MAX_TRAILS = 5;

  // ─── State ─────────────────────────────────────────
  let cols = 0, rows = 0, dpr = 1;
  let activeTrails = [];
  let lastSpawn = 0;
  let nextDelay = rand(SPAWN_MIN, SPAWN_MAX);
  let baseCanvas = null;  // offscreen cached base dots
  let animId;

  function rand(a, b) { return a + Math.random() * (b - a); }
  function randInt(a, b) { return Math.floor(rand(a, b + 1)); }

  // ─── Build offscreen base dots ─────────────────────
  function buildBaseCanvas() {
    baseCanvas = document.createElement('canvas');
    baseCanvas.width = canvas.width;
    baseCanvas.height = canvas.height;
    const bctx = baseCanvas.getContext('2d');
    if (!bctx) return;
    bctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // Draw all base dots once
    bctx.fillStyle = `rgba(${BASE_R}, ${BASE_G}, ${BASE_B}, ${BASE_ALPHA})`;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        bctx.beginPath();
        bctx.arc(c * GAP, r * GAP, BASE_RADIUS, 0, Math.PI * 2);
        bctx.fill();
      }
    }
  }

  function resize() {
    dpr = window.devicePixelRatio || 1;
    const w = window.innerWidth;
    const h = window.innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    cols = Math.ceil(w / GAP) + 1;
    rows = Math.ceil(h / GAP) + 1;
    buildBaseCanvas();
  }

  // ─── Trail spawning ────────────────────────────────
  function spawnTrail(now) {
    const isHoriz = Math.random() < 0.5;
    const dots = [];

    if (isHoriz) {
      const row = randInt(0, rows - 1);
      const goRight = Math.random() < 0.5;
      const start = goRight
        ? randInt(0, Math.max(0, cols - TRAIL_LENGTH))
        : randInt(Math.min(TRAIL_LENGTH - 1, cols - 1), cols - 1);
      const step = goRight ? 1 : -1;
      for (let i = 0; i < TRAIL_LENGTH; i++) {
        const c = start + i * step;
        if (c < 0 || c >= cols) break;
        dots.push({ col: c, row: row });
      }
    } else {
      const col = randInt(0, cols - 1);
      const goDown = Math.random() < 0.5;
      const start = goDown
        ? randInt(0, Math.max(0, rows - TRAIL_LENGTH))
        : randInt(Math.min(TRAIL_LENGTH - 1, rows - 1), rows - 1);
      const step = goDown ? 1 : -1;
      for (let i = 0; i < TRAIL_LENGTH; i++) {
        const r = start + i * step;
        if (r < 0 || r >= rows) break;
        dots.push({ col: col, row: r });
      }
    }

    if (dots.length === 0) return;

    activeTrails.push(
      dots.map((d, i) => ({
        col: d.col,
        row: d.row,
        activateAt: now + i * DOT_DELAY,
        alpha: 0,
        phase: 0  // 0=waiting, 1=glow, 2=fading, 3=done
      }))
    );
  }

  // ─── Update trail states ───────────────────────────
  function updateTrails(now) {
    for (let t = activeTrails.length - 1; t >= 0; t--) {
      const trail = activeTrails[t];
      let alive = false;

      for (let i = 0; i < trail.length; i++) {
        const d = trail[i];
        if (d.phase === 3) continue;

        alive = true;

        if (d.phase === 0) {
          if (now >= d.activateAt) {
            d.phase = 1;
            d.t0 = now;
          }
        } else if (d.phase === 1) {
          const el = now - d.t0;
          if (el < 60) {
            d.alpha = (el / 60) * GLOW_MAX_ALPHA;
          } else {
            d.phase = 2;
            d.t0 = now;
            d.alpha = GLOW_MAX_ALPHA;
          }
        } else if (d.phase === 2) {
          const p = Math.min(1, (now - d.t0) / DOT_FADE_DURATION);
          d.alpha = GLOW_MAX_ALPHA * (1 - p * p);
          if (p >= 1) { d.alpha = 0; d.phase = 3; }
        }
      }

      if (!alive) activeTrails.splice(t, 1);
    }
  }

  // ─── Render ────────────────────────────────────────
  function draw() {
    const w = window.innerWidth;
    const h = window.innerHeight;
    ctx.clearRect(0, 0, w, h);

    // Stamp the pre-rendered base dots
    if (baseCanvas) {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.drawImage(baseCanvas, 0, 0);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // Overdraw only the glowing dots on top
    for (const trail of activeTrails) {
      for (const d of trail) {
        if (d.alpha < 0.01) continue;
        const x = d.col * GAP;
        const y = d.row * GAP;
        const a = d.alpha;

        // Soft glow halo
        const hr = GLOW_RADIUS + a * 4;
        const grad = ctx.createRadialGradient(x, y, 0, x, y, hr);
        grad.addColorStop(0, `rgba(${GLOW_R},${GLOW_G},${GLOW_B},${a * 0.45})`);
        grad.addColorStop(1, `rgba(${GLOW_R},${GLOW_G},${GLOW_B},0)`);
        ctx.beginPath();
        ctx.arc(x, y, hr, 0, 6.2832);
        ctx.fillStyle = grad;
        ctx.fill();

        // Bright core dot
        ctx.beginPath();
        ctx.arc(x, y, GLOW_RADIUS, 0, 6.2832);
        ctx.fillStyle = `rgba(${GLOW_R},${GLOW_G},${GLOW_B},${a})`;
        ctx.fill();

        // White-hot center
        ctx.beginPath();
        ctx.arc(x, y, BASE_RADIUS * 0.8, 0, 6.2832);
        ctx.fillStyle = `rgba(160,200,255,${a * 0.65})`;
        ctx.fill();
      }
    }
  }

  // ─── Main loop ─────────────────────────────────────
  function loop(ts) {
    const now = ts || performance.now();

    if (now - lastSpawn > nextDelay && activeTrails.length < MAX_TRAILS) {
      spawnTrail(now);
      lastSpawn = now;
      nextDelay = rand(SPAWN_MIN, SPAWN_MAX);
    }

    updateTrails(now);
    draw();
    animId = requestAnimationFrame(loop);
  }

  // ─── Init ──────────────────────────────────────────
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(resize, 150);
  });

  resize();
  lastSpawn = performance.now();
  animId = requestAnimationFrame(loop);

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      cancelAnimationFrame(animId);
    } else {
      lastSpawn = performance.now();
      animId = requestAnimationFrame(loop);
    }
  });
})();
</script>
