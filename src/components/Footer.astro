---
// src/components/Footer.astro
interface Props {
  currentPage?: "home" | "combates";
}

const { currentPage = "home" } = Astro.props;
---

<footer
  class="relative z-10 bg-[#060A1A] border-t border-[#1E2958]/40 pt-14 pb-8 overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Main Top Row: Branding left, Nav links center-right, Social media circles far-right -->
    <div
      class="flex flex-col lg:flex-row items-center justify-between gap-8 pb-10"
    >
      <!-- Left: Logo + Title + Subtitle -->
      <div class="flex items-center gap-4">
        <a
          href="/"
          class="group flex items-center gap-3.5"
          title="Stream Fighters V - Inicio"
        >
          <img
            src="/images/logo2.png"
            alt="Logo Stream Fighters V"
            class="h-11 sm:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          />
          <div class="flex flex-col text-left">
            <span
              class="font-display text-2xl sm:text-3xl font-black text-white tracking-wider leading-none uppercase"
            >
              STREAM FIGHTERS <span class="text-[#4236F5]">V</span>
            </span>
          </div>
        </a>
      </div>

      <!-- Right Group: Navigation Links + Social Media Icons in Round Pills -->
      <div
        class="flex flex-wrap items-center justify-center lg:justify-end gap-6 sm:gap-8"
      >
        <!-- Navigation Links -->
        <nav
          aria-label="Navegación del pie"
          class="flex items-center gap-6 sm:gap-7 text-xs font-bold tracking-widest uppercase text-[#94A3B8]"
        >
          <a
            href="/combates"
            class="hover:text-white transition-colors duration-200"
          >
            COMBATES
          </a>
          <a
            href={currentPage === "home" ? "#informacion" : "/#informacion"}
            class="hover:text-white transition-colors duration-200"
          >
            INFORMACIÓN
          </a>
          <a
            href={currentPage === "home" ? "#transmision" : "/#transmision"}
            class="hover:text-[#53FC18] transition-colors duration-200"
          >
            KICK EN VIVO
          </a>
          <a
            href={currentPage === "home" ? "#ubicacion" : "/#ubicacion"}
            class="hover:text-white transition-colors duration-200"
          >
            UBICACIÓN
          </a>
        </nav>

        <!-- Circular Social Media Icons -->
        <div class="flex items-center gap-2.5">
          <!-- Kick (Special Green Highlight) -->
          <a
            href="https://kick.com/westcol"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-[#0E2018] border border-[#53FC18]/40 flex items-center justify-center text-[#53FC18] hover:border-[#53FC18] hover:bg-[#53FC18]/20 hover:shadow-[0_0_14px_rgba(83,252,24,0.5)] transition-all duration-200 group"
            title="Kick.com/WestCol"
            aria-label="Kick"
          >
            <span
              class="font-black text-sm leading-none font-mono tracking-tighter transition-transform group-hover:scale-110"
              >K</span
            >
          </a>

          <!-- Instagram -->
          <a
            href="https://www.instagram.com/stream_fighters/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-[#11162B] border border-[#1E2958]/80 flex items-center justify-center text-[#94A3B8] hover:text-white hover:border-[#E1306C] hover:bg-[#E1306C]/10 hover:shadow-[0_0_12px_rgba(225,48,108,0.4)] transition-all duration-200 group"
            title="Instagram Oficial"
            aria-label="Instagram"
          >
            <svg
              class="w-4 h-4 transition-transform group-hover:scale-110"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <!-- YouTube -->
          <a
            href="https://youtube.com/@westcol?si=EMheJedoearUpUVM"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-[#11162B] border border-[#1E2958]/80 flex items-center justify-center text-[#94A3B8] hover:text-[#FF0000] hover:border-[#FF0000]/60 hover:bg-[#FF0000]/10 hover:shadow-[0_0_12px_rgba(255,0,0,0.3)] transition-all duration-200 group"
            title="YouTube"
            aria-label="YouTube"
          >
            <svg
              class="w-4 h-4 transition-transform group-hover:scale-110"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Fine Line Divider and Metadata Credits Row (Matches the reference photo style) -->
    <div
      class="border-t border-[#161F42]/80 pt-6 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6 text-[11px] font-mono tracking-wider text-[#64748B] uppercase text-center"
    >
      <div>
        <span>DERECHOS RESERVADOS &copy; STREAM FIGHTERS 2026</span>
      </div>
    </div>
  </div>
</footer>
