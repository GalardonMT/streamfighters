<section
  id="informacion"
  class="relative z-10 py-20 lg:py-28 border-t border-[#1E2958]/60 overflow-hidden bg-[#060919]/80 backdrop-blur-2xl"
>
  <!-- Geometric Corner Tech Accents (Completamente Desenfocados y Suaves) -->
  <div
    class="absolute -top-6 -left-6 w-40 sm:w-56 h-40 sm:h-56 pointer-events-none select-none z-0 filter blur-[6px] opacity-40"
  >
    <svg viewBox="0 0 200 200" fill="none" class="w-full h-full opacity-60">
      <polygon points="0,0 160,0 60,100 0,100" fill="url(#cornerGradTL)"
      ></polygon>
      <line x1="0" y1="104" x2="62" y2="104" stroke="#4236F5" stroke-width="2.5"
      ></line>
      <line x1="62" y1="104" x2="164" y2="2" stroke="#4236F5" stroke-width="2.5"
      ></line>
      <polygon points="0,0 120,0 30,90 0,90" fill="#1C1132" fill-opacity="0.5"
      ></polygon>
      <defs>
        <linearGradient
          id="cornerGradTL"
          x1="0"
          y1="0"
          x2="160"
          y2="100"
          gradientUnits="userSpaceOnUse"
        >
          <stop stop-color="#4236F5" stop-opacity="0.4"></stop>
          <stop offset="1" stop-color="#7928CA" stop-opacity="0.1"></stop>
        </linearGradient>
      </defs>
    </svg>
  </div>

  <div
    class="absolute -bottom-6 -right-6 w-40 sm:w-56 h-40 sm:h-56 pointer-events-none select-none z-0 rotate-180 filter blur-[6px] opacity-40"
  >
    <svg viewBox="0 0 200 200" fill="none" class="w-full h-full opacity-60">
      <polygon points="0,0 160,0 60,100 0,100" fill="url(#cornerGradBR)"
