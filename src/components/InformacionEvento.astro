<!-- Client JavaScript for Accordions & Price Tabs -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // ── Collapsible Accordion Sections ──
    const accordions = document.querySelectorAll(".info-accordion");

    accordions.forEach((accordion) => {
      const trigger = accordion.querySelector(".info-accordion-trigger");
      const panel = accordion.querySelector(".info-accordion-panel");
      const iconSvg = accordion.querySelector(".info-accordion-icon");

      if (!trigger || !panel) return;

      trigger.addEventListener("click", () => {
        const isOpen = panel.style.maxHeight && panel.style.maxHeight !== "0px";

        if (!isOpen) {
          // Open
          panel.style.maxHeight = panel.scrollHeight + 30 + "px";
          panel.classList.remove("opacity-0");
          panel.classList.add("opacity-100");
          if (iconSvg) iconSvg.style.transform = "rotate(180deg)";
        } else {
          // Close
          panel.style.maxHeight = "0px";
          panel.classList.add("opacity-0");
          panel.classList.remove("opacity-100");
          if (iconSvg) iconSvg.style.transform = "rotate(0deg)";
        }
      });
    });

    // ── Price Table Tabs ──
    const tabs = document.querySelectorAll(".precio-tab");
    const tablas = document.querySelectorAll(".precio-tabla");

    tabs.forEach((tab) => {
      tab.addEventListener("click", (e) => {
        e.stopPropagation();
        const targetId = tab.getAttribute("data-target");

        tabs.forEach((t) => {
          t.classList.remove(
            "bg-[#4236F5]",
            "text-[#EBEBF4]",
            "border-[#4236F5]",
            "active-tab",
          );
          t.classList.add(
            "bg-transparent",
            "text-[#B58E7D]",
            "border-[#B58E7D]/20",
          );
        });

        tab.classList.add(
          "bg-[#4236F5]",
          "text-[#EBEBF4]",
          "border-[#4236F5]",
          "active-tab",
        );
        tab.classList.remove(
          "bg-transparent",
          "text-[#B58E7D]",
          "border-[#B58E7D]/20",
        );

        tablas.forEach((tabla) => {
          if (tabla.id === targetId) {
            tabla.classList.remove("hidden");
          } else {
            tabla.classList.add("hidden");
          }
        });

        // Recalc parent accordion height after tab switch
        const parentPanel = tab.closest(".info-accordion-panel");
        if (
          parentPanel &&
          parentPanel.style.maxHeight &&
          parentPanel.style.maxHeight !== "0px"
        ) {
          setTimeout(() => {
            parentPanel.style.maxHeight = parentPanel.scrollHeight + 30 + "px";
          }, 50);
        }
      });
    });

    // ── Cyberpunk Ambient Particle Effect ──
    (function initParticlesCanvas() {
      const canvas = document.getElementById("glitch-bg-canvas");
      const section = document.getElementById("informacion");
      if (!canvas || !section) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let w = 0;
      let h = 0;
      let animId = null;

      // Palette colors for particles
      const palette = [
        { color: "#a855f7", shadow: "rgba(168, 85, 247, 0.8)" }, // Neon Violet
        { color: "#c084fc", shadow: "rgba(192, 132, 252, 0.75)" }, // Light Purple
        { color: "#4236F5", shadow: "rgba(66, 54, 245, 0.85)" }, // SF5 Electric Blue
        { color: "#38bdf8", shadow: "rgba(56, 189, 248, 0.7)" }, // Cyan/Sky Blue
        { color: "#53FC18", shadow: "rgba(83, 252, 24, 0.75)" }, // Kick Green Accent
        { color: "#EBEBF4", shadow: "rgba(235, 235, 244, 0.9)" }, // Silver Starlight
      ];

      let particles = [];

      function initParticles() {
        particles = [];
        // Scale count based on area, between 70 and 150
        const count = Math.min(150, Math.max(70, Math.floor((w * h) / 12000)));

        for (let i = 0; i < count; i++) {
          const item = palette[Math.floor(Math.random() * palette.length)];
          const rand = Math.random();
          // Bokeh orbs desenfocados (bokeh discs de lente) y partículas difusas
          const isBokeh = rand < 0.35; // 35% orbs bokeh desenfocados
          const isMedium = !isBokeh && rand < 0.75;
          const size = isBokeh
            ? Math.random() * 16 + 12 // 12px a 28px orbes bokeh
            : isMedium
              ? Math.random() * 5 + 4 // 4px a 9px
              : Math.random() * 2 + 1.5;

          particles.push({
            x: Math.random() * w,
            y: Math.random() * h,
            size,
            vx: (Math.random() - 0.5) * (isBokeh ? 0.2 : 0.35),
            vy: (Math.random() - 0.5) * (isBokeh ? 0.15 : 0.25) - 0.04, // deriva lenta hacia arriba
            baseAlpha: isBokeh
              ? Math.random() * 0.28 + 0.15 // suave y difuso
              : Math.random() * 0.45 + 0.25,
            color: item.color,
            shadow: item.shadow,
            twinkleSpeed: Math.random() * 0.018 + 0.006,
            phase: Math.random() * Math.PI * 2,
          });
        }
      }

      function resize() {
        const rect = section.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = Math.floor(rect.width);
        h = Math.floor(rect.height);

        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        ctx.resetTransform?.();
        ctx.scale(dpr, dpr);

        if (particles.length === 0) {
          initParticles();
        } else {
          // Adjust particles that are outside the new bounds
          particles.forEach((p) => {
            if (p.x > w) p.x = Math.random() * w;
            if (p.y > h) p.y = Math.random() * h;
          });
        }
      }

      function draw(time) {
        if (!w || !h) {
          animId = requestAnimationFrame(draw);
          return;
        }

        ctx.clearRect(0, 0, w, h);

        ctx.save();
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];

          // Move
          p.x += p.vx;
          p.y += p.vy;

          // Wrap boundaries
          if (p.x < -10) p.x = w + 10;
          else if (p.x > w + 10) p.x = -10;
          if (p.y < -10) p.y = h + 10;
          else if (p.y > h + 10) p.y = -10;

          // Twinkle pulse
          const alpha = Math.max(
            0.08,
            Math.min(
              0.95,
              p.baseAlpha + Math.sin(time * p.twinkleSpeed + p.phase) * 0.25,
            ),
          );

          ctx.globalAlpha = alpha;
          ctx.shadowBlur = p.size * 8;
          ctx.shadowColor = p.shadow;
          ctx.fillStyle = p.color;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();

        animId = requestAnimationFrame(draw);
      }

      // Initialize and observe size changes
      resize();
      const resizeObserver = new ResizeObserver(() => {
        resize();
      });
      resizeObserver.observe(section);

      animId = requestAnimationFrame(draw);
    })();
  });
</script>
