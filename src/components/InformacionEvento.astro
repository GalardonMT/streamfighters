    class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[1100px] h-[650px] bg-[#4236F5]/25 rounded-full blur-[220px] pointer-events-none z-0"
  >
  </div>
  <div
    class="absolute top-5 right-5 w-[600px] h-[600px] bg-[#7928CA]/25 rounded-full blur-[200px] pointer-events-none z-0"
  >
  </div>
  <div
    class="absolute bottom-5 left-5 w-[550px] h-[550px] bg-[#38BDF8]/20 rounded-full blur-[200px] pointer-events-none z-0"
  >
  </div>
  <div
    class="absolute bottom-1/3 right-1/4 w-[450px] h-[450px] bg-[#53FC18]/10 rounded-full blur-[180px] pointer-events-none z-0"
