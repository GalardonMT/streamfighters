---
// src/components/Ubicacion.astro
// Componente de mapa del evento y fotografía del Coliseo MedPlus
---

<section
  id="ubicacion"
  class="relative z-10 py-16 lg:py-24 border-t border-[#B58E7D]/20 overflow-hidden bg-gradient-to-b from-[#060A1A] via-[#100B22] to-[#060A1A]"
>
  <!-- Glow decorativo de fondo -->
  <div
    class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-[#4236F5]/15 rounded-full blur-[140px] pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-10 right-1/4 w-96 h-96 bg-[#53FC18]/10 rounded-full blur-[150px] pointer-events-none"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header de la sección -->
    <div class="text-center mb-12 sm:mb-16">
      <h2
        class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#EBEBF4] tracking-tight uppercase"
      >
        ¿DÓNDE SE <span class="text-[#4236F5]">ENCUENTRA</span> EL COLISEO?
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#B58E7D] max-w-2xl mx-auto">
        Coliseo MedPlus (Arena Bogotá) • Km 1.5 Vía Bogotá - Cota, Cundinamarca,
        Colombia. El recinto techado multipropósito más moderno del país.
      </p>
    </div>

    <!-- Contenedor de 2 Columnas: Izquierda Imagen del Coliseo, Derecha Mapa de Google Maps -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      <!-- IZQUIERDA: Tarjeta con Imagen del Coliseo MedPlus e Información -->
      <div
        class="group relative flex flex-col justify-between bg-[#1C1132]/70 backdrop-blur-xl border border-[#B58E7D]/20 hover:border-[#4236F5]/50 rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl transition-all duration-300"
      >
        <!-- Imagen del Coliseo MedPlus -->
        <div
          class="relative h-64 sm:h-72 md:h-80 w-full overflow-hidden bg-[#060A1A]"
        >
          <img
            src="/images/coliseo-medplus.jpg"
            alt="Fachada del Coliseo MedPlus Bogotá iluminada de noche"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
            loading="lazy"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-[#1C1132] via-transparent to-black/30"
          >
          </div>

          <div class="absolute bottom-4 left-4 right-4">
            <span
              class="text-[11px] font-mono text-[#53FC18] font-bold uppercase tracking-wider block"
            >
              Capacidad: +15.000 Espectadores
            </span>
            <h3
              class="font-display text-2xl sm:text-3xl font-extrabold text-[#EBEBF4] drop-shadow-md"
            >
              Coliseo MedPlus
            </h3>
          </div>
        </div>

        <!-- Detalles informativos del recinto -->
        <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow">
          <div class="space-y-4 text-xs sm:text-sm text-[#B58E7D]">
            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 rounded-lg bg-[#4236F5]/20 border border-[#4236F5]/40 flex items-center justify-center shrink-0 text-[#4236F5]"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <strong class="text-[#EBEBF4] block font-semibold"
                  >Dirección:</strong
                >
                <span
                  >Km 1.5 Vía Bogotá - Cota (Costado Occidental), Cundinamarca,
                  Colombia</span
                >
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 rounded-lg bg-[#53FC18]/20 border border-[#53FC18]/40 flex items-center justify-center shrink-0 text-[#53FC18]"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <strong class="text-[#EBEBF4] block font-semibold"
                  >Horario de Ingreso:</strong
                >
                <span
                  >Apertura de puertas: 15:30 (GMT-5) | Alfombra Roja: 17:00 |
                  Inicio Combates: 17:30</span
                >
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div
                class="w-8 h-8 rounded-lg bg-[#B58E7D]/20 border border-[#B58E7D]/40 flex items-center justify-center shrink-0 text-[#EBEBF4]"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                </svg>
              </div>
              <div>
                <strong class="text-[#EBEBF4] block font-semibold"
                  >Transporte y Accesos:</strong
                >
                <span
                  >Rutas circulares especiales desde el Portal de la 80,
                  parqueaderos vigilados y bahías de taxis autorizados.</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- DERECHA: Mapa interactivo de Google Maps -->
      <div
        class="flex flex-col rounded-2xl sm:rounded-3xl overflow-hidden border border-[#B58E7D]/25 bg-[#1C1132]/60 backdrop-blur-md shadow-2xl relative min-h-[420px] lg:min-h-full"
      >
        <!-- iframe del Mapa de Google Maps -->
        <div class="relative flex-grow w-full min-h-[380px] sm:min-h-[440px]">
          <iframe
            title="Mapa de ubicación en Google Maps - Coliseo MedPlus"
            src="https://maps.google.com/maps?q=Coliseo%20MedPlus,%20Cota,%20Cundinamarca,%20Colombia&t=&z=15&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 w-full h-full filter contrast-105 saturate-110"
          ></iframe>
        </div>

        <!-- Barra inferior del mapa -->
        <div
          class="bg-[#060A1A]/90 border-t border-[#B58E7D]/20 px-5 py-3 flex items-center justify-between text-xs text-[#B58E7D]"
        >
          <span>Bogotá - Cota, Cundinamarca</span>
        </div>
      </div>
    </div>
  </div>
</section>
