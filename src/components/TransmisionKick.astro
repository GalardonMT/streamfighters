---
// src/components/TransmisionKick.astro
---

<section
  id="transmision"
  class="relative z-10 py-14 lg:py-20 border-t border-[#B58E7D]/20 overflow-hidden"
>
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Header Minimalista -->
    <div class="mb-8">
      <h2
        class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#EBEBF4] tracking-tight leading-none uppercase"
      >
        ¿DÓNDE VER <span class="text-[#53FC18]">STREAM FIGHTERS V</span>?
      </h2>

      <p class="mt-3 text-xs sm:text-sm text-[#B58E7D] max-w-xl mx-auto">
        Transmisión mundial gratuita en máxima resolución a través del canal
        oficial.
      </p>
      <p>
        <strong class="text-[#53FC18]">Westcol en Kick</strong>
      </p>
    </div>

    <!-- Preview Stream Minimalista -->
    <div
      class="relative rounded-2xl overflow-hidden border border-[#53FC18]/30 bg-[#0A0718] group shadow-[0_15px_40px_rgba(0,0,0,0.7)]"
    >
      <div class="relative aspect-video max-h-[460px] w-full overflow-hidden">
        <img
          src="/images/cartelera-completa.png"
          alt="Stream Fighters V en vivo por Kick"
          class="w-full h-full object-cover filter brightness-50 group-hover:scale-105 transition-transform duration-700"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#060A1A] via-black/40 to-transparent"
        >
        </div>

        <!-- Floating Live Pill (Top-Left) -->
        <div class="absolute top-4 left-4 flex items-center gap-2">
          <span
            class="px-2.5 py-1 rounded-md bg-red-600 text-white text-[11px] font-black uppercase tracking-wider flex items-center gap-1.5 shadow-md"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"
            ></span>
            EN DIRECTO
          </span>
          <span
            class="px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-md text-[#53FC18] text-[11px] font-mono font-bold border border-[#53FC18]/30"
          >
            KICK.COM/WESTCOL
          </span>
        </div>

        <!-- Center CTA: Play on Kick -->
        <div
          class="absolute inset-0 flex flex-col items-center justify-center p-4"
        >
          <a
            href="https://kick.com/westcol"
            target="_blank"
            rel="noopener noreferrer"
            class="group/btn relative flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#53FC18] hover:bg-[#43e40a] text-[#060A1A] shadow-[0_0_30px_rgba(83,252,24,0.5)] hover:scale-110 active:scale-95 transition-all duration-300"
            aria-label="Abrir stream oficial de WestCol en Kick"
          >
            <svg class="w-8 h-8 ml-1 fill-current" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </a>
          <span
            class="mt-4 font-display text-xl sm:text-2xl font-extrabold text-[#EBEBF4] tracking-wider drop-shadow-md"
          >
            SINTONIZAR EN KICK
          </span>
        </div>

        <!-- Bottom Info Bar -->
        <div
          class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-xs text-[#EBEBF4]"
        >
          <div class="flex items-center gap-2">
            <span class="font-bold text-xs sm:text-sm text-[#EBEBF4]"> </span>
          </div>
          <div
            class="flex items-center gap-3 text-[11px] font-mono text-[#53FC18]"
          >
            <span>100% GRATIS</span>
            <span>•</span>
            <span>4K 60FPS</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Minimalist Action Bar -->
    <div
      class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs text-[#B58E7D]"
    >
      <span class="flex items-center gap-1.5">
        Web, App de Kick (iOS / Android) y Smart TV
      </span>
      <span class="hidden sm:inline text-[#B58E7D]/40">•</span>
      <a
        href="https://kick.com/westcol"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#53FC18] hover:underline font-bold inline-flex items-center gap-1"
      >
        <span>Abrir kick.com/westcol</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>
