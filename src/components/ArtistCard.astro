---
// src/components/ArtistCard.astro
import type { Artist } from '../data/eventData';
import CountryFlag from './CountryFlag.astro';
import '../styles/artistas.css';

interface Props {
  artist: Artist;
}

const { artist } = Astro.props;
---

<div class="artista-card group">
  <div>
    <!-- Image with live performance stage vibe -->
    <div class="artista-img-wrapper">
      <img 
        src={artist.image} 
        alt={artist.name} 
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1C1132] via-[#1C1132]/30 to-transparent"></div>

      <!-- Time and Status Badge -->
      <div class="absolute top-3 left-3 px-3 py-1 rounded-full bg-[#060A1A]/85 backdrop-blur-md border border-[#B58E7D]/30 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#4236F5] animate-ping"></span>
        <span class="text-[11px] font-bold text-[#EBEBF4] tracking-wider uppercase">{artist.status}</span>
      </div>

      <div class="absolute top-3 right-3 drop-shadow">
        <CountryFlag country={artist.country} flagEmoji={artist.flag} size="md" />
      </div>

      <!-- Stage time banner at bottom -->
      <div class="artista-time-badge text-xs text-[#EBEBF4]">
        <svg class="w-3.5 h-3.5 text-[#B58E7D]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="font-semibold text-[11px]">{artist.stageTime}</span>
      </div>
    </div>

    <!-- Artist info -->
    <div class="mb-3">
      <div class="flex items-baseline justify-between gap-2">
        <h3 class="font-display text-3xl font-extrabold text-[#EBEBF4] group-hover:text-[#4236F5] transition-colors tracking-wide leading-none">
          {artist.name}
        </h3>
        <span class="text-xs text-[#B58E7D] uppercase font-bold tracking-wider">{artist.country}</span>
      </div>
      <p class="text-xs font-semibold text-[#B58E7D] mt-1">{artist.genre}</p>
    </div>

    <!-- Bio text -->
    <p class="text-xs text-[#EBEBF4]/80 leading-relaxed mb-4 line-clamp-2">
      {artist.bio}
    </p>

    <!-- Hits tags -->
    <div class="mb-4">
      <span class="text-[10px] uppercase font-bold tracking-wider text-[#B58E7D] block mb-1.5">Éxitos Confirmados:</span>
      <div class="flex flex-wrap gap-1.5">
        {artist.hits.map((hit) => (
          <span class="hit-pill">
            🎵 {hit}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom CTA -->
  <div class="pt-3 border-t border-[#B58E7D]/20 flex items-center justify-between gap-2">
    <span class="text-xs text-[#B58E7D]">
      @{artist.instagram}
    </span>
    
    <button 
      type="button"
      class="bg-[#4236F5] hover:bg-[#3428df] text-[#EBEBF4] text-xs font-bold py-2 px-3.5 rounded-lg shadow-md shadow-[#4236F5]/30 hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer flex items-center gap-1.5"
      onclick={`alert('Setlist especial de ${artist.name} programado para:\\n${artist.stageTime}\\n\\n¡Prepárate para vivir el mejor espectáculo!')`}
    >
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
      </svg>
      Ver Show
    </button>
  </div>
</div>
