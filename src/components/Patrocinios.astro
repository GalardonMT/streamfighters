---
// src/components/Patrocinios.astro
---

<section
  id="patrocinios"
  class="relative z-10 py-14 lg:py-18 border-t border-[#1E2958]/40 overflow-hidden bg-transparent"
>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Minimalista -->
    <div class="text-center mb-10 sm:mb-12">
      <h2
        class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#EBEBF4] tracking-wider uppercase"
      >
        PATROCINADORES <span class="text-[#4236F5]">OFICIALES</span>
      </h2>
    </div>

    <!-- Logos Strip (Totalmente minimalista, sin cards ni recuadros) -->
    <div
      class="flex flex-wrap items-center justify-center gap-10 sm:gap-14 lg:gap-20 select-none"
    >
      <!-- Logo 1: KICK -->
      <a
        href="https://kick.com/westcol"
        target="_blank"
        rel="noopener noreferrer"
        title="Kick - Streaming Oficial"
        class="group text-[#EBEBF4]/60 hover:text-[#53FC18] transition-all duration-300 hover:scale-105 flex items-center focus:outline-none"
      >
        <svg
          class="h-8 sm:h-10 w-auto fill-current transition-all drop-shadow-[0_0_15px_rgba(83,252,24,0)] group-hover:drop-shadow-[0_0_20px_rgba(83,252,24,0.5)]"
          viewBox="0 0 115 36"
        >
          <!-- K -->
          <path d="M0 0h12v12h6V6h6V0h12v12h-6v6h-6v6h6v6h6v12H24v-6h-6v-6h-6v12H0V0z"/>
          <!-- I -->
          <path d="M42 0h12v36H42V0z"/>
          <!-- C -->
          <path d="M60 0h24v12H72v12h12v12H60V0z"/>
          <!-- K -->
          <path d="M90 0h12v12h6V6h6V0h12v12h-6v6h-6v6h6v6h6v12h-12v-6h-6v-6h-6v12H90V0z"/>
        </svg>
      </a>

      <!-- Logo 2: STAKE -->
      <a
        href="https://stake.com"
        target="_blank"
        rel="noopener noreferrer"
        title="Stake - Patrocinador Oficial"
