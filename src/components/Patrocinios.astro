      <!-- Logo 3: TAQUILLA LIVE -->
      <a
        href="https://www.taquillalive.com/performance-details/?artist=westcol&event=TCL.EVN1440.PRF1"
        target="_blank"
        rel="noopener noreferrer"
        title="TaquillaLive - Boletería Oficial"
        class="group text-[#EBEBF4]/60 hover:text-[#EBEBF4] transition-all duration-300 hover:scale-105 flex items-center focus:outline-none"
      >
        <div class="flex items-center gap-3">
          <svg
            class="w-8 h-8 sm:w-10 sm:h-10 fill-none stroke-current transition-colors group-hover:stroke-[#4236F5] group-hover:drop-shadow-[0_0_15px_rgba(66,54,245,0.6)]"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"
            />
          </svg>
          <div class="flex flex-col text-left">
            <span
              class="font-display text-2xl sm:text-3xl font-extrabold tracking-wider leading-none text-[#EBEBF4]/80 group-hover:text-[#EBEBF4] transition-colors"
            >
              TAQUILLA
            </span>
            <span
              class="text-[10px] sm:text-[11px] font-black tracking-[0.25em] text-[#4236F5] uppercase leading-tight"
            >
              LIVE
            </span>
          </div>
        </div>
      </a>

      <!-- Logo 4: COLISEO MEDPLUS -->
      <a
        href="https://coliseomedplus.com/"
        target="_blank"
        rel="noopener noreferrer"
        title="Coliseo MedPlus - Escenario Oficial"
        class="group text-[#EBEBF4]/60 hover:text-[#EBEBF4] transition-all duration-300 hover:scale-105 flex items-center focus:outline-none"
      >
        <div class="flex items-center gap-3">
          <svg
            class="w-8 h-8 sm:w-10 sm:h-10 fill-none stroke-current transition-colors group-hover:stroke-[#B58E7D] group-hover:drop-shadow-[0_0_15px_rgba(181,142,125,0.5)]"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <ellipse cx="12" cy="12" rx="10" ry="7" />
            <ellipse cx="12" cy="12" rx="6" ry="4" />
            <path d="M2 12v3c0 3.87 4.48 7 10 7s10-3.13 10-7v-3" />
          </svg>
          <div class="flex flex-col text-left">
            <span
              class="font-display text-2xl sm:text-3xl font-extrabold tracking-wider leading-none text-[#EBEBF4]/80 group-hover:text-[#EBEBF4] transition-colors"
            >
              COLISEO
            </span>
            <span
              class="text-[10px] sm:text-[11px] font-black tracking-[0.25em] text-[#B58E7D] uppercase leading-tight"
            >
              MEDPLUS
            </span>
          </div>
        </div>
